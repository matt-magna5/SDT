# Output files - don't commit client data
_output/
*.html
*.json
!detection_rules.json
*.zip
*.xlsx

# Python
__pycache__/
*.pyc

# Portable Python bundle — run Get-PortablePython.ps1 to set up locally
python/

# Keep archive scripts but not output
_archive/*.html
_archive/*.json
_archive/*.zip

# Prepackaged dependencies ship inside every release so installs work on
# networks that block python.org / the.earth.li / pypi.org.
!deps/*.zip
